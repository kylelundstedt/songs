[Unit]
Description=Songs V2 isolated read-only shell and bootstrap API
After=network-online.target

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/songs-v2
ExecStart=/home/exedev/songs-v2/srv/songs-v2-api -listen 127.0.0.1:8001
Restart=always
RestartSec=3
Environment=HOME=/home/exedev
Environment=USER=exedev

[Install]
WantedBy=multi-user.target
